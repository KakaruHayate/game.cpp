{
  "name": "game-midi-studio",
  "version": "0.1.0",
  "description": "GAME (singing-voice-to-MIDI) desktop UI on ggml — import oudep package, input vocals, render & export MIDI",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "author": "KakaruHayate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KakaruHayate/game.cpp.git"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.game.midistudio",
    "productName": "GAME MIDI Studio",
    "files": [
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo"
    }
  }
}
